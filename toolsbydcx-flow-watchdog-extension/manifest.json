{
  "manifest_version": 3,
  "name": "ToolsByDcx Flow Watchdog",
  "version": "1.0.2",
  "description": "Protects the ToolsByDcx Flow Guard browser profile.",
  "minimum_chrome_version": "120",
  "permissions": ["management", "cookies", "tabs", "storage", "alarms"],
  "host_permissions": ["https://google.com/*", "https://*.google.com/*", "https://*.googleusercontent.com/*", "https://flow.google.com/*", "https://toolsbydcx.com/*", "https://www.toolsbydcx.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
