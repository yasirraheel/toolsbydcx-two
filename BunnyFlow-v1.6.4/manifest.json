{
  "manifest_version": 3,
  "name": "BunnyFlow",
  "version": "1.6.4",
  "description": "Opens and prepares Google Flow for your active BunnyFlow plan.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs", "alarms", "webNavigation", "declarativeNetRequest", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "incognito": "not_allowed",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "BunnyFlow", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "content_scripts": [{
    "matches": ["https://flowbybunny.com/*", "https://www.flowbybunny.com/*"],
    "js": ["browser-guard.js", "site-bridge.js"],
    "run_at": "document_idle",
    "all_frames": false
  }, {
    "matches": [
      "https://flow.google.com/*", "https://accounts.google.com/*",
      "https://*.google.com/*", "https://*.google.com.pk/*",
      "https://www.google.com/*", "https://www.google.com.pk/*",
      "https://www.google.co.uk/*", "https://www.google.ca/*",
      "https://www.google.com.au/*", "https://www.google.co.in/*",
      "https://www.google.de/*", "https://www.google.fr/*",
      "https://www.google.es/*", "https://www.google.it/*",
      "https://www.google.nl/*", "https://www.google.com.br/*",
      "https://www.google.com.mx/*", "https://www.google.co.jp/*",
      "https://www.google.co.za/*", "https://www.google.com.tr/*"
    ],
    "js": ["privacy-only.js"],
    "run_at": "document_start",
    "all_frames": true
  }, {
    "matches": ["https://flow.google.com/*"],
    "js": ["browser-guard.js", "login-blocker.js", "flow-privacy.js", "lower-model-prompt.js"],
    "run_at": "document_start",
    "all_frames": false
  }, {
    "matches": ["https://accounts.google.com/*", "https://flow.google.com/*"],
    "js": ["browser-guard.js", "progress-overlay.js", "automation.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'" }
}