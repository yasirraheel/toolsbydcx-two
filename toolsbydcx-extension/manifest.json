{
  "manifest_version": 3,
  "name": "ToolsByDcx Flow",
  "version": "1.0.0",
  "description": "Opens and prepares Google Flow for your active ToolsByDcx plan.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "webNavigation",
    "declarativeNetRequest",
    "scripting"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ToolsByDcx Flow",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://toolsbydcx.com/*", "https://www.toolsbydcx.com/*"],
      "js": ["browser-guard.js", "site-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://accounts.google.com/*",
        "https://*.google.com/*",
        "https://*.google.com.pk/*",
        "https://www.google.com/*",
        "https://www.google.co.uk/*",
        "https://www.google.ca/*",
        "https://www.google.com.au/*",
        "https://www.google.co.in/*",
        "https://www.google.de/*",
        "https://www.google.fr/*",
        "https://www.google.es/*"
      ],
      "js": ["privacy-only.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["browser-guard.js", "login-blocker.js", "flow-privacy.js", "lower-model-prompt.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://accounts.google.com/*", "https://flow.google.com/*"],
      "js": ["browser-guard.js", "progress-overlay.js", "automation.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"
  }
}
